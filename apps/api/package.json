{
  "name": "@kpn/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node --enable-source-maps dist/index.js",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate": "tsx src/db/migrate.ts",
    "operator:assign-corporate-resource": "tsx src/operations/assign-corporate-resource-cli.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@kpn/config": "^0.1.0",
    "@kpn/contracts": "^0.1.0",
    "fastify": "^5.12.0",
    "jose": "^5.9.6",
    "pg": "^8.23.0",
    "stripe": "^22.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4",
    "vitest": "^4.1.10"
  }
}
