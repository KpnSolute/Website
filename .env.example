# KpnSolute shared platform — environment variables (no values, see docs/local-development.md).
# Any variable left unset causes the corresponding feature to fail closed with
# an explicit "setup required" state rather than fake production behavior.

# --- apps/api -----------------------------------------------------------

# PostgreSQL connection string. Required for every persistence-backed route.
# Example shape (do not commit a real value): postgres://user:password@host:5432/kpnsolute
DATABASE_URL=

# Port and bind host for the shared API server.
PORT=4000
HOST=0.0.0.0

# node environment. "production" enables secure cookies.
NODE_ENV=development

# KpnAuth Supabase Auth authority. Publishable keys are safe in browser builds;
# service-role and database credentials remain server-only.
SUPABASE_URL=https://vwbrxcltetelvvkbnbru.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ISSUER=https://vwbrxcltetelvvkbnbru.supabase.co/auth/v1
SUPABASE_JWKS_URL=https://vwbrxcltetelvvkbnbru.supabase.co/auth/v1/.well-known/jwks.json

# Tenant workforce tokens use a distinct, short-lived asymmetric signing key.
# Store real PEM values only in the deployment secret store. The public key is
# distributed to product adapters; the private key remains KpnAuth server-only.
WORKFORCE_JWT_PRIVATE_KEY=
WORKFORCE_JWT_PUBLIC_KEY=
WORKFORCE_JWT_KEY_ID=
WORKFORCE_JWT_ISSUER=https://auth.kpnsolute.com

# Stripe secret key for Billing checkout/subscription management. Unset
# means every billing checkout route fails closed with setup_required.
STRIPE_SECRET_KEY=

# Origin used to build Stripe success/cancel URLs when a request's own
# Origin/Host headers are not reliable (e.g. behind a proxy). Optional.
BILLING_APP_ORIGIN=

# --- Frontend apps (apps/hub, accounts, auth, platform, create, billing, --
# --- link, flow) — each app reads its own Vite env, prefixed VITE_.     --

# Shared API origin every frontend app targets. In production this is the
# gateway origin (https://api.kpnsolute.com), never a Render hostname.
VITE_API_BASE_URL=http://localhost:4000

# Optional override of the gateway origin for the workforce sign-in host in
# apps/auth. Same shape as VITE_API_BASE_URL, which it falls back to. Paths are
# appended as public gateway paths (/auth/oauth/..., /auth/workforce/...), so
# this must be the API origin and must not already include a service segment.
VITE_KPN_API_URL=

# KpnAuth OAuth 2.1 authority used by relying-party apps.
VITE_KPNAUTH_URL=https://vwbrxcltetelvvkbnbru.supabase.co

# Used only by the auth consent UI.
VITE_SUPABASE_URL=https://vwbrxcltetelvvkbnbru.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
